  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "import os, json, subprocess\nREPO = '/content/jais-voice-agent'\nif not os.path.exists(REPO):\n    subprocess.run(['git', 'clone', '--depth', '1',\n                    'https://github.com/911houssem/jais-voice-agent.git', REPO], check=True)\nelse:\n    subprocess.run(['git', '-C', REPO, 'pull'], check=False)\n\nCONFIG = {\n    'PORT': 8000,\n    'ASR_SIZE': 'small',            # faster-whisper: tiny/base/small/medium/large-v3\n    'ASR_DEVICE': 'cpu',\n    'LLM_MODEL': 'inception42/Jais-3-7B',\n    'LLM_8BIT': True,               # ~7GB VRAM: يمنع OOM على T4 المجاني (16GB)\n    'TTS_VOICE': 'ar-SA-HamedNeural',\n}\njson.dump(CONFIG, open('/content/.jais_config.json', 'w'), ensure_ascii=False)\nprint('✅ الكود والإعدادات جاهزة:', CONFIG)"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "import torch\nif torch.cuda.is_available():\n    print('✅ GPU:', torch.cuda.get_device_name(0))\nelse:\n    print('⚠️ لا يوجد GPU — اختر T4 من: Runtime → Change runtime type (النموذج لن يعمل بسرعة على المعالج)')\n\nfrom huggingface_hub import snapshot_download\nsnapshot_download('inception42/Jais-3-7B')\nprint('✅ نموذج Jais-3-7B نُزّل وجاهز')\n\nfrom faster_whisper import WhisperModel\nWhisperModel('small', device='cpu', compute_type='int8')\nprint('✅ نموذج التعرّف على الكلام (ASR) جاهز')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "# Reload-safe server start: stops any previous instance and re-imports the\n# freshly pulled code, so Run all always serves the latest version.\nimport sys, urllib.request, importlib, threading, time\nsys.path.insert(0, '/content/jais-voice-agent/kaggle')\nimport kaggle_app\n\nold = getattr(kaggle_app, '_server', None)\nif old is not None:\n    old.should_exit = True           # shut down previous uvicorn thread\n    time.sleep(3)\nimportlib.reload(kaggle_app)         # pick up the code from git pull\nkaggle_app.start_app(8000)\nprint('Health:', urllib.request.urlopen('http://127.0.0.1:8000/health').read().decode())\n\n# Warm up the LLM in the background: first request loads the 8-bit model\n# (~1 min). Doing it server-side avoids the Cloudflare 100s timeout.\ndef _warm():\n    try:\n        req = urllib.request.Request(\n            'http://127.0.0.1:8000/api/turn',\n            data='{"text":"\\u0645\\u0631\\u062d\\u0628\\u0627"}'.encode('utf-8'),\n            headers={'Content-Type': 'application/json'})\n        r = urllib.request.urlopen(req, timeout=600).read().decode()\n        print('WARMUP OK:', r[:160])\n    except Exception as e:\n        print('WARMUP ERR:', e)\nthreading.Thread(target=_warm, daemon=True).start()"
  },
  {
   "cell_type": "code",
