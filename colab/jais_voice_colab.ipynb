   "outputs": [],
   "source": "# cloudflared keeps its output buffered when stdout is a pipe (no TTY),\n# so readline() would hang forever. We redirect to a file and poll it instead.\nimport subprocess, re, time, os\nif not os.path.exists('/usr/local/bin/cloudflared'):\n    subprocess.run(['wget', '-q',\n                    'https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64',\n                    '-O', '/usr/local/bin/cloudflared'], check=True)\n    subprocess.run(['chmod', '+x', '/usr/local/bin/cloudflared'], check=True)\n\nLOG = '/tmp/cf.log'\nif os.path.exists(LOG):\n    os.remove(LOG)\nproc = subprocess.Popen(\n    ['cloudflared', 'tunnel', '--url', 'http://127.0.0.1:8000'],\n    stdout=open(LOG, 'w'), stderr=subprocess.STDOUT)\n\nurl = None\nfor _ in range(60):          # max ~60s\n    time.sleep(1)\n    try:\n        txt = open(LOG, encoding='utf-8', errors='ignore').read()\n    except Exception:\n        txt = ''\n    m = re.search(r'https://[a-z0-9-]+\\.trycloudflare\\.com', txt)\n    if m:\n        url = m.group(0)\n        break\n    if proc.poll() is not None:\n        break\n\nif url:\n    from IPython.display import display, HTML\n    display(HTML(f'<h2>🔗 رابط الوكيل الصوتي (عام — افتحه وتكلم): <a href=\"{url}\" target=\"_blank\">{url}</a></h2>'))\nelse:\n    print('تعذّر إنشاء الرابط — أعد تشغيل هذه الخلية')\n    print(open(LOG, encoding=\"utf-8\", errors=\"ignore\").read()[-800:])"
  }
